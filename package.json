{
  "name": "grafana-dashboard-helpers",
  "main": "src/grafana-helpers.ts",
  "scripts": {
    "generate": "bun dashboards/dashboards.ts",
    "dev": "bun --watch dashboards/dashboards.ts",
    "typecheck": "bun x tsc --noEmit",
    "format": "bun x biome format --write .",
    "lint": "bun x biome lint .",
    "check": "bun x biome check --write ."
  },
  "files": [
    "src/**/*"
  ],
  "dependencies": {
    "@grafana/grafana-foundation-sdk": "^11.1.0-cogv0.0.x.1746458718",
    "@grafana/promql-builder": "^0.0.4",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.15.21"
  }
}
